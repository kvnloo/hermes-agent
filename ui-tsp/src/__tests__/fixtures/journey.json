{
  "source": "RFC #510 §4.C",
  "evidence": "synthetic App + gateway replay, not live host",
  "steps": [
    {
      "id": "fresh",
      "intent": "inspect",
      "expect": "idle"
    },
    {
      "id": "prompt",
      "intent": "send",
      "text": "Inspect the local fixture and explain changes",
      "expect": "turn-submitted"
    },
    {
      "id": "thinking",
      "events": [
        {
          "type": "message.start",
          "payload": {}
        },
        {
          "type": "reasoning.delta",
          "payload": {
            "text": "Checking local sources first."
          }
        }
      ],
      "expect": "reasoning-visible"
    },
    {
      "id": "read-search",
      "events": [
        {
          "type": "tool.start",
          "payload": {
            "tool_id": "read-1",
            "name": "read_file",
            "args": {
              "path": "src/main.ts"
            }
          }
        },
        {
          "type": "tool.complete",
          "payload": {
            "tool_id": "read-1",
            "name": "read_file",
            "result": {
              "content": "const answer = 42",
              "total_lines": 1
            }
          }
        },
        {
          "type": "tool.start",
          "payload": {
            "tool_id": "search-1",
            "name": "search_files",
            "args": {
              "path": "src",
              "pattern": "answer"
            }
          }
        },
        {
          "type": "tool.complete",
          "payload": {
            "tool_id": "search-1",
            "name": "search_files",
            "result": {
              "matches": [
                {
                  "path": "src/main.ts",
                  "line": 1,
                  "content": "const answer = 42"
                }
              ],
              "total_count": 1
            }
          }
        }
      ],
      "expect": "two-tools"
    },
    {
      "id": "write-edit",
      "events": [
        {
          "type": "tool.start",
          "payload": {
            "tool_id": "write-1",
            "name": "write_file",
            "args": {
              "path": "src/answer.ts",
              "content": "export const answer = 42"
            }
          }
        },
        {
          "type": "tool.complete",
          "payload": {
            "tool_id": "write-1",
            "name": "write_file",
            "result": {
              "success": true,
              "path": "src/answer.ts"
            }
          }
        },
        {
          "type": "tool.start",
          "payload": {
            "tool_id": "edit-1",
            "name": "patch",
            "args": {
              "path": "src/main.ts",
              "old_string": "answer = 42",
              "new_string": "answer = 43"
            }
          }
        },
        {
          "type": "tool.complete",
          "payload": {
            "tool_id": "edit-1",
            "name": "patch",
            "result": {
              "success": true,
              "diff": "@@ -1 +1 @@\n-const answer = 42\n+const answer = 43"
            }
          }
        }
      ],
      "expect": "edit-retained"
    },
    {
      "id": "subagent",
      "events": [
        {
          "type": "tool.start",
          "payload": {
            "tool_id": "delegate-1",
            "name": "delegate_task",
            "args": {
              "tasks": [
                {
                  "goal": "Review this change"
                }
              ]
            }
          }
        },
        {
          "type": "subagent.start",
          "payload": {
            "task_index": 0,
            "subagent_id": "worker-1",
            "goal": "Review this change",
            "status": "running",
            "model": "fixture-review-model"
          }
        }
      ],
      "expect": "agent-running"
    },
    {
      "id": "queued-follow-up",
      "intent": "send",
      "text": "Summarize any potential regressions afterward",
      "expect": "queued"
    },
    {
      "id": "approval",
      "intent": "approval",
      "expect": "approval-owned"
    },
    {
      "id": "failure-recovery",
      "events": [
        {
          "type": "tool.start",
          "payload": {
            "tool_id": "fail-1",
            "name": "terminal",
            "args": {
              "command": "exit 2"
            }
          }
        },
        {
          "type": "tool.complete",
          "payload": {
            "tool_id": "fail-1",
            "name": "terminal",
            "result": {
              "exit_code": 2,
              "output": "failure fixture"
            }
          }
        },
        {
          "type": "tool.start",
          "payload": {
            "tool_id": "recover-1",
            "name": "terminal",
            "args": {
              "command": "printf ok"
            }
          }
        },
        {
          "type": "tool.complete",
          "payload": {
            "tool_id": "recover-1",
            "name": "terminal",
            "result": {
              "exit_code": 0,
              "output": "ok"
            }
          }
        }
      ],
      "expect": "failure-and-recovery"
    },
    {
      "id": "completion",
      "events": [
        {
          "type": "subagent.complete",
          "payload": {
            "task_index": 0,
            "subagent_id": "worker-1",
            "goal": "Review this change",
            "status": "completed",
            "summary": "Reviewed",
            "duration_seconds": 1
          }
        },
        {
          "type": "tool.complete",
          "payload": {
            "tool_id": "delegate-1",
            "name": "delegate_task",
            "result": {
              "delegation_id": "delegate-fixture",
              "summary": "Reviewed"
            }
          }
        },
        {
          "type": "message.complete",
          "payload": {
            "status": "complete",
            "text": "Implemented and tested in fixture."
          }
        }
      ],
      "expect": "queued-handoff"
    },
    {
      "id": "model-picker",
      "intent": "model-picker",
      "expect": "model-options-only"
    },
    {
      "id": "background-inspection",
      "events": [
        {
          "type": "background.complete",
          "payload": {
            "task_id": "background-1",
            "text": "# Background report\n\nRead-only findings"
          }
        }
      ],
      "intent": "jobs",
      "expect": "report-separate"
    },
    {
      "id": "split-preview",
      "intent": "visual-picker",
      "expect": "preview-choice-no-host-claim"
    },
    {
      "id": "back-to-chat",
      "intent": "close-overlays",
      "expect": "draft-restored"
    }
  ]
}
