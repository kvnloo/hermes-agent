  "commands_note": "Cards for apps Hermes reaches through a CLI in the terminal tool instead of MCP (GitHub is not in Hermes' MCP catalog; its github/* skills drive `gh`). Keys are the executable; `subcommands` is checked in order against the command's leading non-flag words (\"run list\", \"pr checks\"), first match wins, null = no card.",
  "commands": {
    "gh": {
      "app": "github",
      "subcommands": [
        [
          "^(run|workflow)( |$)|^pr checks",
          "ci"
        ],
        [
          "^pr (view|list|status|diff|merge|create|ready|review)",
          "merge"
        ],
        [
          "",
          null
        ]
      ]
