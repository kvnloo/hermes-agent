 apps/desktop/electron/git-worktree-ops.test.ts | 13 +++++++------
 apps/desktop/electron/git-worktree-ops.ts      | 16 ++++++++--------
 hermes_cli/web_git.py                          |  9 +++++----
 tests/hermes_cli/test_web_server_git.py        |  9 ++++++---
