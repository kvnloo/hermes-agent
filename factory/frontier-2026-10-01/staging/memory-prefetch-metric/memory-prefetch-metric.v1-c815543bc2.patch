diff --git a/hermes_cli/observability/shared_metrics_loop.py b/hermes_cli/observability/shared_metrics_loop.py
index 19892e8e2a..0e5e68bf26 100644
--- a/hermes_cli/observability/shared_metrics_loop.py
+++ b/hermes_cli/observability/shared_metrics_loop.py
@@ -15,6 +15,7 @@ import contextvars
 import json
 import logging
 import threading
+import time
 from dataclasses import dataclass, field
 from typing import Any, Callable, Iterable, Iterator
 
@@ -158,6 +159,26 @@ def record_provider_memory_call(provider: Any, tool_name: Any, args: Any, result
     _record_memory_ops([memory_provider_op(tool_name, args)], provider=provider, outcome=outcome)
 
 
+def memory_prefetch_fields(*, provider: Any, outcome: Any, waited_ms: Any) -> dict[str, str]:
+    from .shared_metrics_contract import MEMORY_PREFETCH_OUTCOMES, tool_latency_bucket
+
+    outcome_value = _norm(outcome)
+    return {
+        "latency_bucket": tool_latency_bucket(waited_ms),
+        "outcome": outcome_value if outcome_value in MEMORY_PREFETCH_OUTCOMES else "failed",
+        "provider": memory_provider_name(provider),
+    }
+
+
+def record_memory_prefetch(provider: Any, outcome: str, started: float) -> None:
+    """One row per external-provider prefetch: what it returned and how long the turn waited on it
+    (``started`` is the caller's ``time.monotonic()``). Never the query or the recalled text."""
+    _emit(
+        "MEMORY_PREFETCH_MARK", memory_prefetch_fields, provider=provider, outcome=outcome,
+        waited_ms=(time.monotonic() - started) * 1000,
+    )
+
+
 # ---- curator ---------------------------------------------------------------------------------
 
 _CURATOR_COUNT_KEYS = ("archived", "created", "merged", "patched")
