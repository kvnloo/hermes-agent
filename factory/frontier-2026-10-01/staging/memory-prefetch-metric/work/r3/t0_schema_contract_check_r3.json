  },
  "doc_row": "| `hermes.memory.prefetch.count` | provider (a bundled memory plugin, else `plugin`), outcome (`success`/`empty`/`failed`/`timed_out`/`skipped`), latency bucket (the tool-call buckets, `lt_100ms` \u2026 `gte_30s`) | How often the external memory provider's turn-start recall returns context, comes back empty, fails or hits the prefetch timeout, and how long the turn waited on it. `skipped` means its previous recall is still running, so this turn did not ask it. Never the query or the recalled text. |",
  "bundled_memory_providers": [
    "builtin",
    "byterover",
    "holographic",
    "honcho",
    "mem0",
    "openviking",
    "plugin",
    "retaindb",
    "supermemory"
  ],
  "all_pass": true
