 },
 "not_tested": [
  "a real Anthropic account (the binding rule is emulated)",
  "Bedrock Converse across a restart (same predicate; not run)",
  "the /model, fallback-provider and gateway-rebuild code paths themselves"
 ],
 "limitations": [
  "the SessionDB resume keeps reasoning_details (signed thinking) but not anthropic_content_blocks; the gate declines on either",
  "phase B and C use 4 and 2 turns; other lengths change how many rows were archived, not whether they revert"
 ],
