+  tool_result_projection: off                       # Wire-only replacement of stale tool results by stubs ("auto" enables; see below)
+  tool_result_projection_min_tokens: 0              # Stale tool payload (tokens) needed before a pass; also the minimum reclaim
+  tool_result_projection_min_result_chars: 4000     # Only tool results larger than this (chars) are eligible
