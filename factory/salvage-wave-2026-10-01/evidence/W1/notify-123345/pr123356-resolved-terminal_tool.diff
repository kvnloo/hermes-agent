+def _coerce_terminal_bool(val: Any, default: bool = False) -> bool:
+    if val is None:
+        return default
+    if isinstance(val, bool):
+        return val
+    if isinstance(val, str):
+        low = val.strip().lower()
+        if low in ("false", "0", "no", "off"):
+            return False
+        if low in ("true", "1", "yes", "on"):
+            return True
+    return bool(val)
